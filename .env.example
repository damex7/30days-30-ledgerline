# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (Neon dashboard -> Connect -> pooled connection)
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Public base URL, used in invitation links, emails and WhatsApp share links
APP_URL=http://localhost:3030

# 'gemini' or 'mock'. With no GEMINI_API_KEY the mock provider is used automatically.
AI_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey (server-only; never sent to the browser)
GEMINI_API_KEY=
# Model names come from env so a retired model is a config change, not a code change.
AI_MODEL=gemini-3.5-flash-lite
AI_FAST_MODEL=gemini-3.1-flash-lite

# Optional: without it, emails are printed to the terminal instead of sent
RESEND_API_KEY=
EMAIL_FROM=Ledgerline <onboarding@resend.dev>

# Protects /api/cron/daily (Vercel Cron sends "Authorization: Bearer <secret>")
CRON_SECRET=replace-with-a-long-random-string

# Password for every seeded demo account (npm run db:seed)
SEED_PASSWORD=replace-me-seed-password
